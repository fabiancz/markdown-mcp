# GHCR image tracking the latest stable release.
IMAGE=ghcr.io/fabiancz/markdown-mcp:latest
REPO_DIR=./repo
DATA_DIR=./data
GIT_PROVIDER=forgejo
GIT_REPO_URL=https://forge.example/owner/vault.git
GIT_TARGET_BRANCH=
GIT_USERNAME=kb-mcp-bot
GIT_PAT=replace-with-repository-read-token
FORGE_API_URL=
FORGE_REPO_ID=
SYNC_BEFORE_READ=true
SYNC_MIN_INTERVAL_SECONDS=0
SYNC_FAILURE_POLICY=serve_stale
WRITE_ENABLED=false
WRITE_DEFAULT_MODE=review
YOLO_ENABLED=false
HOST_PORT=8000
PUBLIC_BASE_URL=https://mcp.example.com
GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-app-secret
GITHUB_ALLOWED_USER_IDS=123456
OAUTH_REDIRECT_URIS=https://client.example/oauth/callback
