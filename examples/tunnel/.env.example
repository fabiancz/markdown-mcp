# GHCR image tracking the latest stable release.
IMAGE=ghcr.io/fabiancz/markdown-mcp:latest
REPO_DIR=./repo
DATA_DIR=./data
GIT_PROVIDER=forgejo
GIT_REPO_URL=https://forge.example/owner/vault.git
GIT_ALLOW_HTTP=false
GIT_TARGET_BRANCH=
GIT_USERNAME=kb-mcp-bot
GIT_PAT=replace-with-repository-read-token
# Forgejo writes: write:repository; PR discussion reads also need read:issue.
FORGE_API_URL=
FORGE_REPO_ID=
SYNC_BEFORE_READ=true
SYNC_MIN_INTERVAL_SECONDS=0
SYNC_FAILURE_POLICY=serve_stale
# Enable only after validating Git/API access for Forgejo review writes.
WRITE_ENABLED=false
WRITE_MAX_OPERATIONS=50
WRITE_MAX_BYTES=1048576
WRITE_POLL_SECONDS=10
FORGE_TIMEOUT_SECONDS=15
WRITE_DEFAULT_MODE=review
YOLO_ENABLED=false
TUNNEL_IMAGE=ghcr.io/openai/tunnel-client@sha256:119799b778ba8411a124f53588f9dc837fd62ba03e5fadf77d675123c92ab58e
OPENAI_TUNNEL_ID=replace-with-tunnel-id
OPENAI_TUNNEL_API_KEY=replace-with-tunnel-runtime-key

# Chat file staging: original bytes, not encoded request size.
UPLOAD_MAX_FILE_BYTES=2000000
UPLOAD_MAX_CHANGE_BYTES=10000000
UPLOAD_STAGING_MAX_BYTES=100000000
UPLOAD_RETENTION_SECONDS=86400
# Exact hosts or patterns, e.g. files.oaiusercontent.com,oaisdmntpr*.blob.core.windows.net
# A standalone * allows all hosts; HTTPS/public-IP/TLS checks still apply.
UPLOAD_ALLOWED_HOSTS=files.oaiusercontent.com
ATTACHMENTS_FOLDER=attachments
